PORT=5000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ciphershield
# Set DB_SSL=true when connecting to a managed Postgres that requires SSL (e.g. Render)
DB_SSL=false
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
AI_SERVICE_URL=http://127.0.0.1:8000
CLIENT_URL=http://localhost:5173
CASE_AUTO_CREATE_THRESHOLD=70
BLOCK_THRESHOLD=85
REVIEW_THRESHOLD=55
